<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Easily - Job Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Easily</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="/jobs">Jobs</a></li>
          <% if (locals.userEmail) { %>
            <li class="nav-item"><a class="nav-link" href="/jobs/new">Post New Job</a></li>
          <% } %>
        </ul>
        <form class="d-flex" action="/jobs" method="GET">
          <input class="form-control me-2" type="search" name="search" placeholder="Search Jobs">
          <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
        <ul class="navbar-nav ms-auto">
          <% if (locals.userEmail) { %>
            <li class="nav-item"><form action="/logout" method="POST"><button class="btn btn-link nav-link">Logout</button></form></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Recruiter Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <% if (locals.lastVisit) { %>
    <div class="alert alert-info text-center m-0">Last Visit: <%= lastVisit %></div>
  <% } %>

  <div class="container mt-4">
    <%- body %>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</body>
</html>