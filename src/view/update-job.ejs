<h2>Update Job Posting</h2>
<form action="/jobs/<%= job.id %>/update" method="POST">
  <div class="mb-3"><label>Designation</label><input type="text" name="jobdesignation" value="<%= job.jobdesignation %>" class="form-control" required></div>
  <div class="mb-3"><label>Category</label><input type="text" name="jobcategory" value="<%= job.jobcategory %>" class="form-control" required></div>
  <div class="mb-3"><label>Company Name</label><input type="text" name="companyname" value="<%= job.companyname %>" class="form-control" required></div>
  <div class="mb-3"><label>Location</label><input type="text" name="joblocation" value="<%= job.joblocation %>" class="form-control" required></div>
  <div class="mb-3"><label>Salary Range</label><input type="text" name="salary" value="<%= job.salary %>" class="form-control" required></div>
  <div class="mb-3"><label>Openings</label><input type="number" name="numberofopenings" value="<%= job.numberofopenings %>" class="form-control" required></div>
  <div class="mb-3"><label>Apply By</label><input type="date" name="applyby" value="<%= job.applyby %>" class="form-control" required></div>
  <button type="submit" class="btn btn-primary">Save Changes</button>
</form>